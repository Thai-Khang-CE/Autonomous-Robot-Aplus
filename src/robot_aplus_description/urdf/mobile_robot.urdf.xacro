<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_aplus">

  <!-- Prototype dimensions in metres. -->
  <xacro:property name="wheel_radius" value="0.065"/>
  <xacro:property name="wheel_separation" value="0.290"/>
  <xacro:property name="wheel_width" value="0.020"/>
  <xacro:property name="lower_deck_length" value="0.340"/>
  <xacro:property name="lower_deck_width" value="0.240"/>
  <xacro:property name="lower_deck_thickness" value="0.010"/>
  <xacro:property name="upper_deck_length" value="0.300"/>
  <xacro:property name="upper_deck_width" value="0.220"/>
  <xacro:property name="upper_deck_thickness" value="0.010"/>
  <xacro:property name="upper_deck_center_z" value="0.100"/>
  <xacro:property name="pillar_radius" value="0.0075"/>
  <xacro:property name="pillar_x_offset" value="0.125"/>
  <xacro:property name="pillar_y_offset" value="0.090"/>
  <xacro:property name="pillar_height"
                  value="${upper_deck_center_z - upper_deck_thickness/2 - lower_deck_thickness/2}"/>
  <xacro:property name="pillar_center_z"
                  value="${(lower_deck_thickness/2 + upper_deck_center_z - upper_deck_thickness/2)/2}"/>
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.040"/>
  <xacro:property name="lidar_center_z"
                  value="${upper_deck_center_z + upper_deck_thickness/2 + lidar_height/2}"/>
  <xacro:property name="rear_support_x" value="-0.130"/>
  <xacro:property name="rear_support_radius" value="0.015"/>
  <xacro:property name="rear_support_stem_radius" value="0.005"/>
  <xacro:property name="rear_support_stem_height" value="0.030"/>
  <xacro:property name="rear_support_center_z"
                  value="${rear_support_radius - wheel_radius}"/>
  <xacro:property name="rear_support_stem_center_z"
                  value="${rear_support_radius + rear_support_stem_height/2}"/>

  <!-- Prototype masses in kilograms; inertia assumes uniform solid primitives. -->
  <xacro:property name="lower_deck_mass" value="0.80"/>
  <xacro:property name="upper_deck_mass" value="0.30"/>
  <xacro:property name="pillar_mass" value="0.025"/>
  <xacro:property name="wheel_mass" value="0.15"/>
  <xacro:property name="lidar_mass" value="0.15"/>
  <xacro:property name="rear_support_ball_mass" value="0.04"/>
  <xacro:property name="rear_support_stem_mass" value="0.01"/>

  <xacro:property name="chassis_mass"
                  value="${lower_deck_mass + upper_deck_mass + 4*pillar_mass}"/>
  <xacro:property name="chassis_com_z"
                  value="${(upper_deck_mass*upper_deck_center_z + 4*pillar_mass*pillar_center_z)/chassis_mass}"/>
  <xacro:property name="chassis_ixx"
                  value="${lower_deck_mass*(lower_deck_width**2 + lower_deck_thickness**2)/12 + lower_deck_mass*chassis_com_z**2 + upper_deck_mass*(upper_deck_width**2 + upper_deck_thickness**2)/12 + upper_deck_mass*(upper_deck_center_z - chassis_com_z)**2 + 4*(pillar_mass*(3*pillar_radius**2 + pillar_height**2)/12 + pillar_mass*(pillar_y_offset**2 + (pillar_center_z - chassis_com_z)**2))}"/>
  <xacro:property name="chassis_iyy"
                  value="${lower_deck_mass*(lower_deck_length**2 + lower_deck_thickness**2)/12 + lower_deck_mass*chassis_com_z**2 + upper_deck_mass*(upper_deck_length**2 + upper_deck_thickness**2)/12 + upper_deck_mass*(upper_deck_center_z - chassis_com_z)**2 + 4*(pillar_mass*(3*pillar_radius**2 + pillar_height**2)/12 + pillar_mass*(pillar_x_offset**2 + (pillar_center_z - chassis_com_z)**2))}"/>
  <xacro:property name="chassis_izz"
                  value="${lower_deck_mass*(lower_deck_length**2 + lower_deck_width**2)/12 + upper_deck_mass*(upper_deck_length**2 + upper_deck_width**2)/12 + 4*(pillar_mass*pillar_radius**2/2 + pillar_mass*(pillar_x_offset**2 + pillar_y_offset**2))}"/>
  <xacro:property name="wheel_transverse_inertia"
                  value="${wheel_mass*(3*wheel_radius**2 + wheel_width**2)/12}"/>
  <xacro:property name="wheel_axial_inertia"
                  value="${wheel_mass*wheel_radius**2/2}"/>
  <xacro:property name="lidar_transverse_inertia"
                  value="${lidar_mass*(3*lidar_radius**2 + lidar_height**2)/12}"/>
  <xacro:property name="lidar_axial_inertia"
                  value="${lidar_mass*lidar_radius**2/2}"/>
  <xacro:property name="rear_support_mass"
                  value="${rear_support_ball_mass + rear_support_stem_mass}"/>
  <xacro:property name="rear_support_com_z"
                  value="${rear_support_stem_mass*rear_support_stem_center_z/rear_support_mass}"/>
  <xacro:property name="rear_support_transverse_inertia"
                  value="${2*rear_support_ball_mass*rear_support_radius**2/5 + rear_support_ball_mass*rear_support_com_z**2 + rear_support_stem_mass*(3*rear_support_stem_radius**2 + rear_support_stem_height**2)/12 + rear_support_stem_mass*(rear_support_stem_center_z - rear_support_com_z)**2}"/>
  <xacro:property name="rear_support_axial_inertia"
                  value="${2*rear_support_ball_mass*rear_support_radius**2/5 + rear_support_stem_mass*rear_support_stem_radius**2/2}"/>

  <xacro:macro name="support_pillar" params="x y">
    <visual>
      <origin xyz="${x} ${y} ${pillar_center_z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${pillar_radius}" length="${pillar_height}"/>
      </geometry>
      <material name="pillar_gray">
        <color rgba="0.55 0.55 0.55 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${x} ${y} ${pillar_center_z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${pillar_radius}" length="${pillar_height}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="drive_wheel" params="name side">
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_transverse_inertia}" ixy="0" ixz="0"
                 iyy="${wheel_axial_inertia}" iyz="0"
                 izz="${wheel_transverse_inertia}"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="0 ${side*wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Ground-plane projection of the drive axle midpoint. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Fixed two-deck chassis and four symmetric support pillars. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${lower_deck_length} ${lower_deck_width} ${lower_deck_thickness}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${lower_deck_length} ${lower_deck_width} ${lower_deck_thickness}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 ${upper_deck_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${upper_deck_length} ${upper_deck_width} ${upper_deck_thickness}"/>
      </geometry>
      <material name="upper_blue">
        <color rgba="0.2 0.5 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${upper_deck_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${upper_deck_length} ${upper_deck_width} ${upper_deck_thickness}"/>
      </geometry>
    </collision>
    <xacro:support_pillar x="${ pillar_x_offset}" y="${ pillar_y_offset}"/>
    <xacro:support_pillar x="${ pillar_x_offset}" y="${-pillar_y_offset}"/>
    <xacro:support_pillar x="${-pillar_x_offset}" y="${ pillar_y_offset}"/>
    <xacro:support_pillar x="${-pillar_x_offset}" y="${-pillar_y_offset}"/>
    <inertial>
      <origin xyz="0 0 ${chassis_com_z}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${chassis_ixx}" ixy="0" ixz="0"
               iyy="${chassis_iyy}" iyz="0" izz="${chassis_izz}"/>
    </inertial>
  </link>

  <!-- Drive wheels: positive rotation about +Y rolls the robot toward +X. -->
  <xacro:drive_wheel name="left" side="${1}"/>
  <xacro:drive_wheel name="right" side="${-1}"/>

  <!-- LiDAR housing; the frame keeps body axes (+X forward, +Z up). -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${lidar_mass}"/>
      <inertia ixx="${lidar_transverse_inertia}" ixy="0" ixz="0"
               iyy="${lidar_transverse_inertia}" iyz="0"
               izz="${lidar_axial_inertia}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_center_z}" rpy="0 0 0"/>
  </joint>

  <!-- Rigid visual approximation of a rear passive ball support. -->
  <link name="rear_support_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${rear_support_radius}"/>
      </geometry>
      <material name="support_black">
        <color rgba="0.12 0.12 0.12 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${rear_support_radius}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 ${rear_support_stem_center_z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${rear_support_stem_radius}" length="${rear_support_stem_height}"/>
      </geometry>
      <material name="support_gray">
        <color rgba="0.55 0.55 0.55 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${rear_support_stem_center_z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${rear_support_stem_radius}" length="${rear_support_stem_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${rear_support_com_z}" rpy="0 0 0"/>
      <mass value="${rear_support_mass}"/>
      <inertia ixx="${rear_support_transverse_inertia}" ixy="0" ixz="0"
               iyy="${rear_support_transverse_inertia}" iyz="0"
               izz="${rear_support_axial_inertia}"/>
    </inertial>
  </link>

  <joint name="rear_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_support_link"/>
    <origin xyz="${rear_support_x} 0 ${rear_support_center_z}" rpy="0 0 0"/>
  </joint>

</robot>
