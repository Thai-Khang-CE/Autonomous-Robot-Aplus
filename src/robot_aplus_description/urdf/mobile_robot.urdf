<?xml version="1.0"?>
<robot name="robot_aplus">

  <!-- 1. Robot body -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.9 1"/>
      </material>
    </visual>
  </link>

  <!-- 2. Left wheel -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0"
              rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <joint name="left_wheel_joint"
         type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.16 0.05" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <!-- 3. Right wheel -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0"
              rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <joint name="right_wheel_joint"
         type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.16 0.05" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <!-- 4. Lidar sensor housing -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.15 0 0.175" rpy="0 0 0"/>
  </joint>

</robot>
