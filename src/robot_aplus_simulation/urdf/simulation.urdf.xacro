<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_aplus">
  <!-- Reuse the complete team description; geometry and inertia remain authoritative. -->
  <xacro:include filename="$(find robot_aplus_description)/urdf/mobile_robot.urdf.xacro"/>
  <gazebo reference="left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <!-- Sliding approximation only: this fixed sphere is not a rolling caster. -->
  <gazebo reference="rear_support_link"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on><update_rate>10</update_rate>
      <topic>/lidar</topic><gz_frame_id>lidar_link</gz_frame_id>
      <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution>
        <min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle>
      </horizontal></scan><range><min>0.08</min><max>10</max><resolution>0.01</resolution></range></lidar>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_radius>${wheel_radius}</wheel_radius><wheel_separation>${wheel_separation}</wheel_separation>
      <topic>/model/robot_aplus/cmd_vel</topic><odom_topic>/model/robot_aplus/odometry</odom_topic>
      <tf_topic>/model/robot_aplus/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <min_linear_velocity>-0.25</min_linear_velocity><max_linear_velocity>0.25</max_linear_velocity>
      <min_angular_velocity>-0.7</min_angular_velocity><max_angular_velocity>0.7</max_angular_velocity>
      <min_linear_acceleration>-0.12</min_linear_acceleration><max_linear_acceleration>0.12</max_linear_acceleration>
      <min_angular_acceleration>-0.6</min_angular_acceleration><max_angular_acceleration>0.6</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/robot_aplus/joint_state</topic>
      <joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose><publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>20</update_frequency>
    </plugin>
  </gazebo>
</robot>
